# ============================================================
# Show Ring — переменные окружения для docker-compose (этап 15)
# ============================================================
# Скопируй в .env (рядом с docker-compose.yml):
#   cp .env.compose.example .env
# и подставь свои значения.
#
# Отличие от .env.example: здесь хосты — это имена контейнеров
# (postgres, rabbitmq, redis, minio), а не localhost. Compose сам
# резолвит их через DNS внутренней сети.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=show_ring
POSTGRES_USER=show_ring
# В проде задавать через секрет-менеджер, не через файл.
POSTGRES_PASSWORD=show_ring

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- MinIO / S3 ---
S3_ACCESS_KEY=show_ring
S3_SECRET_KEY=show_ring_minio
S3_BUCKET=show-ring-files
S3_REGION=us-east-1

# --- SMTP ---
# Внутри compose-сети SMTP_HOST=mailpit (docker-compose.dev.yml поднимает
# контейнер с этим именем). В prod заменить на реальный SMTP-хост
# (например, smtp.sendgrid.net) + USE_TLS=true + логин/пароль.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@show-ring.local

# --- Auth ---
# Обязательная переменная. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# Внутренний ключ для воркеров (legacy /tasks/{id}/status).
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# --- App ---
DEBUG=false
# Включать ли встроенный APScheduler (этап 9). На dev обычно false,
# на prod выставляется true в одном из инстансов API (не во всех,
# иначе cron-задачи будут запускаться N раз).
SCHEDULER_ENABLED=false

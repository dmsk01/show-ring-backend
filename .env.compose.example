# ============================================================
# Show Ring — переменные окружения для docker-compose (этап 15)
# ============================================================
# Скопируй в .env (рядом с docker-compose.yml):
#   cp .env.compose.example .env
# и подставь свои значения.
#
# Отличие от .env.example: здесь хосты — это имена контейнеров
# (postgres, rabbitmq, redis, minio), а не localhost. Compose сам
# резолвит их через DNS внутренней сети.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=show_ring
POSTGRES_USER=show_ring
# В проде задавать через секрет-менеджер, не через файл.
POSTGRES_PASSWORD=show_ring

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- MinIO / S3 ---
S3_ACCESS_KEY=show_ring
S3_SECRET_KEY=show_ring_minio
S3_BUCKET=show-ring-files
S3_REGION=us-east-1

# --- SMTP ---
# Внутри compose-сети SMTP_HOST=mailpit (docker-compose.dev.yml поднимает
# контейнер с этим именем). В prod заменить на реальный SMTP-хост
# (например, smtp.sendgrid.net) + USE_TLS=true + логин/пароль.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@show-ring.local

# --- Auth ---
# Обязательная переменная. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# Внутренний ключ для воркеров (legacy /tasks/{id}/status).
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# --- App ---
DEBUG=false
# Frontend dev server origin (required for credentialed cross-origin requests).
CORS_ALLOW_ORIGINS=["http://localhost:8082","http://127.0.0.1:8082"]
# Включать ли встроенный APScheduler (этап 9). На dev обычно false,
# на prod выставляется true в одном из инстансов API (не во всех,
# иначе cron-задачи будут запускаться N раз).
SCHEDULER_ENABLED=false

# Фронт (Next dev :8082) проксирует API под /api/* (next.config.ts rewrites) —
# браузер видит /api/auth/..., поэтому path кук должен совпадать. Без этого
# refresh_token-кука (Path=/auth) не отправляется: logout/refresh → 401.
COOKIE_PATH_PREFIX=/api

# Ослабленные rate-limit auth для dev/e2e: через Next-прокси все запросы идут
# с одного IP docker-шлюза, а Playwright делает пачку логинов и регистрацию
# на каждом прогоне. 🚫 ТОЛЬКО dev/e2e — в прод-.env не переносить (там
# дефолты 5/60 для логина и 3/3600 для регистрации).
AUTH_LOGIN_RATE_LIMIT=100
AUTH_REGISTER_RATE_LIMIT=100

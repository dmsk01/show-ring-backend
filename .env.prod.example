# ============================================================
# Show Ring — прод-переменные (.env на VPS, chmod 600, ВНЕ git)
# Скопировать: cp .env.prod.example .env  и заполнить значения.
# ============================================================

# --- Обязательные секреты ---
# >=32 символов, НЕ плейсхолдер: app/config.py валидирует на старте
# и при debug=false роняет приложение. Сгенерировать:
#   openssl rand -hex 32
SECRET_KEY=

POSTGRES_DB=show_ring
POSTGRES_USER=show_ring
POSTGRES_PASSWORD=

RABBITMQ_USER=show_ring
RABBITMQ_PASSWORD=

# MinIO (внутренний S3 для файлов пользователей)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=show-ring-files

# --- Прод-режим приложения ---
DEBUG=false
SCHEDULER_ENABLED=true
# Реальный SMTP (Sendgrid/Mailgun/SES), НЕ mailpit
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@show-ring.example

# --- Деплой ---
# Образы бэка и фронта собираются ЛОКАЛЬНО на сервере (`up --build`),
# из внешнего registry ничего не тянется — тегов IMAGE_TAG/WEB_IMAGE_TAG
# больше нет. Репо фронта (show-ring-frontend) должен лежать рядом с этим
# репо: его собирает сервис web (build: ../show-ring-frontend).
UVICORN_WORKERS=2
# Auth-куки: публичный префикс пути API. nginx отдаёт SPA на «/», API —
# под /api/ (deploy/nginx/conf.d/show-ring.conf). Без префикса браузер
# не приложит куки к /api/* — логин «молча» не залогинит.
COOKIE_PATH_PREFIX=/api

# --- Публичный хост (домен ИЛИ туннель Cloudflare/ngrok) ---
# Порядок включения TLS на своём домене: deploy/nginx/conf.d/show-ring.conf.
# DOMAIN=show-ring.example
# ALLOWED_HOSTS — TrustedHostMiddleware. Пусто = любой Host. За доменом или
# публичным туннелем впиши JSON-список хостов (иначе Host-инъекции).
# ALLOWED_HOSTS=["show-ring.example"]
# FRONTEND_BASE_URL — база для ссылок в письмах (verify-email и пр.).
# Должна совпадать с публичным адресом, иначе письма ведут в никуда.
# FRONTEND_BASE_URL=https://show-ring.example

# --- Бэкапы ---
# BACKUP_CRON=30 3 * * *
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Offsite-S3: задать все четыре -> бэкапы уезжают во внешнее облако.
# Не заданы -> только локальный ./backups (см. спеку: осознанный старт).
# BACKUP_S3_ENDPOINT=https://s3.storage.selcloud.ru
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=show-ring-backups

# ============================================================
# Show Ring — переменные окружения
# ============================================================
# Скопируй в .env и поправь значения если нужно:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
# docker run -d --name postgres -e POSTGRES_USER=show_ring -e POSTGRES_PASSWORD=show_ring -e POSTGRES_DB=show_ring -p 5432:5432 -v pgdata:/var/lib/postgresql/data postgres:17-alpine
DATABASE_URL=postgresql+asyncpg://show_ring:show_ring@localhost:5432/show_ring

# --- RabbitMQ ---
# docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:4-management
RABBITMQ_URL=amqp://guest:guest@localhost/
EXCHANGE_EVENTS=events

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
# DEBUG=true включает echo SQL и dev-эндпоинты типа /health/test-error.
# В проде должно быть false.
DEBUG=false
# Список разрешённых origin'ов для CORS (через запятую). Пустой = CORS выключен.
# CORS_ALLOW_ORIGINS=["https://show-ring.example", "https://admin.show-ring.example"]

# --- Internal API key ---
# Ключ для внутренних запросов воркеров на PUT /tasks/{id}/status.
# Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# --- MinIO / S3 (этап 4) ---
# docker run -d --name minio -p 9000:9000 -p 9001:9001 \
#   -e MINIO_ROOT_USER=show_ring -e MINIO_ROOT_PASSWORD=show_ring_minio \
#   -v minio-data:/data minio/minio server /data --console-address ":9001"
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=show_ring
S3_SECRET_KEY=show_ring_minio
S3_BUCKET=show-ring-files
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_BYTES=10485760

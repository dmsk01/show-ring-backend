# ============================================================
# ShowTail — переменные окружения
# ============================================================
# Скопируй в .env и поправь значения если нужно:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
# docker run -d --name postgres -e POSTGRES_USER=showtail -e POSTGRES_PASSWORD=showtail -e POSTGRES_DB=showtail -p 5432:5432 -v pgdata:/var/lib/postgresql/data postgres:17-alpine
DATABASE_URL=postgresql+asyncpg://showtail:showtail@localhost:5432/showtail

# --- RabbitMQ ---
# docker run -d --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:4-management
RABBITMQ_URL=amqp://guest:guest@localhost/
EXCHANGE_EVENTS=events
